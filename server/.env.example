PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/investomillionaire
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173,https://investomillionaire.com,https://www.investomillionaire.com

# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# Mail goes out over Resend's HTTPS API. Render blocks outbound SMTP ports on free
# instances, so an SMTP transport there hangs and then fails. Leave the key blank in
# dev and the OTP is printed to the server log instead of being emailed.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. A gmail.com sender is rejected.
MAIL_FROM=InvestoMillionaire <no-reply@investomillionaire.com>

# Guards the admin endpoint that can read decrypted mobile numbers.
ADMIN_TOKEN=

# Reads company names off an uploaded screenshot at POST /api/analyze/extract. Get a
# free key at https://ocr.space/ocrapi. Leave it blank and that endpoint answers 503
# saying image reading is not configured, which is the intended behaviour: nothing in
# this project will guess at a ticker it did not actually read.
OCR_SPACE_API_KEY=
