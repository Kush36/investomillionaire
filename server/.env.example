PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/investomillionaire
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173,https://investomillionaire.com,https://www.investomillionaire.com

# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
# Gmail needs an App Password, not the account password. Leave blank in dev and
# the OTP is printed to the server log instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=InvestoMillionaire <investomillionaire@gmail.com>
# Guards the admin endpoint that can read decrypted mobile numbers.
ADMIN_TOKEN=
